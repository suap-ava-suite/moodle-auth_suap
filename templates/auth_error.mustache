{{!
    @template auth_suap/auth_error

    Template to display SUAP authentication error and prompt user to restart login.

    Context variables required for this template:
    * title - Heading for the error box
    * message - Description of the error and instructions
    * loginurl - URL to restart login (/auth/suap/login.php)
    * buttontext - Text for the button to restart login

    Example context (json):
    {
        "title": "Erro de Autenticação",
        "message": "Ocorreu um erro ao comunicar com o SUAP.",
        "loginurl": "https://moodle.example.com/auth/suap/login.php",
        "buttontext": "Tentar novamente"
    }
}}
<div class="auth-suap-error-container card text-center my-5 mx-auto" style="max-width: 600px;">
    <div class="card-body p-5">
        <div class="mb-4 text-danger" style="font-size: 3rem;">
            <i class="fa fa-exclamation-triangle" aria-hidden="true" style="font-size: 150pt;"></i>
        </div>
        <h3 class="card-title mb-3">{{title}}</h3>
        <p class="card-text text-muted mb-4">{{message}}</p>
        <a href="{{loginurl}}" class="btn btn-primary btn-lg">
            {{buttontext}}
        </a>
    </div>
</div>
